{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign has_mobile_image = false

  if section.settings.custom_mobile_media and image_mobile != blank
    assign has_mobile_image = true
  endif

  case section.settings.text_alignment
    when 'left'
      assign text_align = 'left'
      assign justify_content = 'flex-start'
    when 'right'
      assign text_align = 'right'
      assign justify_content = 'flex-end'
    else
      assign text_align = 'center'
      assign justify_content = 'center'
  endcase

  case section.settings.vertical_alignment
    when 'top'
      assign align_items = 'flex-start'
    when 'bottom'
      assign align_items = 'flex-end'
    else
      assign align_items = 'center'
  endcase

  assign widths = '832, 1200, 1600, 1920, 2560, 3840'
  assign mobile_widths = '416, 600, 800, 1200, 1600'
  assign mobile_widths_array = mobile_widths | split: ', '
  assign sizes = '100vw'
%}

<div
  id="HeroBanner-{{ section.id }}"
  class="hero-banner"
  style="
    --hero-banner-text-align: {{ text_align }};
    --hero-banner-justify: {{ justify_content }};
    --hero-banner-align: {{ align_items }};
    {% if section.settings.text_color != blank %}
      --hero-banner-text-color: {{ section.settings.text_color }};
    {% endif %}
    {% if section.settings.section_height == 'custom' %}
      --hero-banner-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --hero-banner-min-height: 100svh;
    {% elsif section.settings.section_height == 'auto' %}
      --hero-banner-min-height: auto;
    {% else %}
      --hero-banner-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
  "
>
  <div class="hero-banner__media" aria-hidden="true">
    {% if image != blank %}
      <picture class="hero-banner__picture">
        {% if has_mobile_image %}
          <source
            media="(max-width: 749px)"
            srcset="
              {%- for mobile_width in mobile_widths_array -%}
                {{ image_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            "
            sizes="{{ sizes }}"
          >
        {% endif %}
        {{
          image
          | image_url: width: 3840
          | image_tag:
            widths: widths,
            sizes: sizes,
            class: 'hero-banner__image',
            alt: image.alt,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </picture>
    {% elsif has_mobile_image %}
      {{
        image_mobile
        | image_url: width: 1600
        | image_tag:
          widths: mobile_widths,
          sizes: sizes,
          class: 'hero-banner__image',
          alt: image_mobile.alt,
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-banner__image hero-banner__image--placeholder' }}
    {% endif %}
  </div>

  {% if section.settings.toggle_overlay %}
    {% render 'overlay', settings: section.settings %}
  {% endif %}

  <div class="hero-banner__content">
    <div class="hero-banner__text">
      {% if heading != blank %}
        <h2 class="hero-banner__heading">{{ heading | escape }}</h2>
      {% endif %}

      {% if subheading != blank %}
        <p class="hero-banner__subheading">{{ subheading | escape | newline_to_br }}</p>
      {% endif %}

      {% if button_label != blank %}
        <a
          class="button hero-banner__button"
          {% if button_link != blank %}
            href="{{ button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    display: flex;
    align-items: var(--hero-banner-align, center);
    justify-content: var(--hero-banner-justify, center);
    min-height: var(--hero-banner-min-height, var(--section-height-medium));
    overflow: hidden;
    color: var(--hero-banner-text-color, var(--color-foreground));
  }

  .hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: var(--layer-base);
  }

  .hero-banner__picture,
  .hero-banner__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__image {
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__image--placeholder {
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.06);
  }

  .hero-banner__content {
    position: relative;
    z-index: var(--layer-raised);
    display: flex;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    justify-content: var(--hero-banner-justify, center);
    padding-block: var(--padding-lg, 2rem);
    padding-inline: var(--page-margin);
  }

  .hero-banner__text {
    display: flex;
    flex-direction: column;
    align-items: var(--hero-banner-justify, center);
    gap: var(--gap-sm, 0.75rem);
    max-width: 40rem;
    text-align: var(--hero-banner-text-align, center);
  }

  .hero-banner__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-h1--size);
    line-height: var(--font-h1--line-height, 1.1);
    color: inherit;
  }

  .hero-banner__subheading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height, 1.5);
    color: inherit;
  }

  .hero-banner__button {
    margin-block-start: var(--gap-sm, 0.75rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero_banner",
  "tag": "section",
  "class": "hero-banner-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.new_arrivals"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:options.subheading",
      "default": "t:text_defaults.shop_our_latest_arrivals"
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.shop_now_button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.background_image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_media",
      "label": "t:settings.custom_mobile_media",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.custom_mobile_media }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "gradient",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_banner",
      "category": "t:categories.banners",
      "settings": {
        "heading": "t:text_defaults.new_arrivals",
        "subheading": "t:text_defaults.shop_our_latest_arrivals",
        "button_label": "t:text_defaults.shop_now_button_label",
        "button_link": "shopify://collections/all",
        "text_alignment": "center",
        "vertical_alignment": "center",
        "section_height": "large",
        "text_color": "#ffffff",
        "toggle_overlay": true,
        "overlay_style": "gradient"
      }
    }
  ]
}
{% endschema %}
